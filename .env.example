# Copy to .env (git-ignored) and fill in. graph.py and mou_api.py read this
# repo's .env unless NK_ENV_FILE points elsewhere. Values are never printed.
OPENAI_API_KEY=
# data.go.kr 통일부 북한동향 service key. The encoded form (with %XX) is fine.
DATA_GO_KR_KEY=
# Only needed when DRY_RUN=0 (a real send).
DISCORD_WEBHOOK_URL=
