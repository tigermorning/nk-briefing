# secrets never enter this repo -- keys live in a git-ignored .env (copy
# .env.example) or wherever NK_ENV_FILE points
.env
*.env
*.key

__pycache__/
*.pyc
.venv/

# probe output, regenerated by mou_probe.py
mou_report.txt
mou_g1_report.txt
*.log
funnel.png
# store/published.json and store/last_seen.json are pipeline state, not probe
# output: the Actions run commits them so tomorrow's run sees today's ledger

# experiment inputs with full article text; regenerated by exp/inputs.py
exp/bodies.json
!exp/*.log

# a probe run with judgement errors keeps the last complete measurement
probe_sources.partial.json
probe_topics*.partial.json
probe_compare.partial.json
